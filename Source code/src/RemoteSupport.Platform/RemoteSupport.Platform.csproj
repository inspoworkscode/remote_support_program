<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>RemoteSupport.Platform</AssemblyName>
    <RootNamespace>RemoteSupport.Platform</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The signup terms (2026-10-05): inside the program, so a deploy can never leave them behind. -->
    <EmbeddedResource Include="Terms/*.txt" LogicalName="Terms.%(Filename).txt" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <!-- MimeKit asks for 10.0.0, which has two published advisories (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- PostgreSQL (2026-10-08, HANDOVER 118): used when ConnectionStrings:Postgres is set; SQLite otherwise. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <ProjectReference Include="..\RemoteSupport.Shared\RemoteSupport.Shared.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
