@page "/owner/admins"
@model RemoteSupport.Platform.Pages.Owner.AdminsModel
@{ ViewData["Title"] = "Admins"; ViewData["Section"] = "owner"; var grantable = PlatformAdmins.Grantable(Model.Me.Level).ToList(); }
<section class="portal"><div class="wrap">
    <h1>Admins <span class="pill pill-muted">@Model.List.Count</span></h1>
    <p class="muted">The people who help you run the platform. You are <strong>@Model.Me.Name</strong>, @PlatformAdmins.Label(Model.Me.Level).</p>
    @if (Model.Message.Length > 0) { <div class="alert alert-ok">@Model.Message</div> }
    @if (Model.Problem.Length > 0) { <div class="alert alert-bad">@Model.Problem @if (Model.ShowLink.Length > 0) { <br><code style="user-select:all;word-break:break-all">@Model.ShowLink</code> }</div> }

    <table id="adminList">
        <tr><th>Name</th><th>Email</th><th>Level</th><th>Last signed in</th><th>Added by</th><th></th></tr>
        @foreach (var a in Model.List)
        {
            var touch = PlatformAdmins.MayTouch(Model.Me, a);
            <tr data-admin="@a.Email" data-id="@a.Id">
                <td><strong>@a.Name</strong>@if (!a.IsSetUp) { <br><span class="pill pill-warn">Not set up yet</span> }</td>
                <td>@a.Email</td>
                <td>
                    @if (touch.Length == 0)
                    {
                        <form method="post" asp-page-handler="Level" class="inline"><input type="hidden" name="id" value="@a.Id">
                            <select name="level" style="padding:4px" onchange="this.form.submit()">
                                @foreach (var l in grantable) { <option value="@((int)l)" selected="@(l == a.Level)">@PlatformAdmins.Label(l)</option> }
                            </select></form>
                    }
                    else { <span title="@PlatformAdmins.Describe(a.Level)">@PlatformAdmins.Label(a.Level)</span> }
                </td>
                <td>@(a.LastSignInUtc?.ToString("yyyy-MM-dd HH:mm") + (a.LastSignInUtc != null ? " UTC" : "—"))</td>
                <td>@a.CreatedBy</td>
                <td style="white-space:nowrap">
                    @if (touch.Length == 0)
                    {
                        <form method="post" asp-page-handler="Link" class="inline" onsubmit="return confirm('Send @a.Name a new set-up link? Their password and authenticator stop working now.')"><input type="hidden" name="id" value="@a.Id"><button class="btn btn-sm" title="Lost link, lost phone or forgotten password">New set-up link</button></form>
                        <form method="post" asp-page-handler="Remove" class="inline" onsubmit="return confirm('Remove @a.Name as an admin?')"><input type="hidden" name="id" value="@a.Id"><button class="btn btn-sm btn-danger">Remove</button></form>
                    }
                </td>
            </tr>
        }
    </table>

    @if (grantable.Count > 0)
    {
        <h2 style="margin-top:36px">Add an admin</h2>
        <form method="post" asp-page-handler="Add" class="form card" id="addAdmin" style="max-width:560px">
            <label>Name</label><input name="name" required maxlength="100">
            <label>Email</label><input name="email" type="email" required>
            <label>Level</label>
            <select name="level">
                @foreach (var l in grantable) { <option value="@((int)l)" selected="@(l == AdminLevel.Manager)">@PlatformAdmins.Label(l) — @PlatformAdmins.Describe(l)</option> }
            </select>
            <p class="muted" style="font-size:13px">They are emailed a link to choose a password and set up an authenticator. Nobody ever knows anybody else's password.</p>
            <div class="actions"><button class="btn btn-accent" type="submit">Add</button></div>
        </form>
    }
    <p class="muted" style="margin-top:24px;font-size:13px">
        <strong>Viewer</strong> sees everything and changes nothing. <strong>Manager</strong> runs companies. <strong>Full</strong> also runs Viewers,
        Managers, servers and mail. Only an <strong>Owner</strong> makes Full admins and Owners, and an Owner is never removed here.
    </p>
</div></section>
