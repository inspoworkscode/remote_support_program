@page
@model LoginModel
@{ ViewData["Title"] = "Sign in"; }
<section class="section">
    <div class="wrap" style="max-width:520px">
        <h1>Sign in to your portal</h1>
        @if (Model.SignedOutWhy.Length > 0) { <div class="alert alert-warn">@Model.SignedOutWhy</div> }
        @if (!string.IsNullOrEmpty(Model.Error)) { <div class="alert alert-bad">@Model.Error</div> }
        @if (Model.Step.Mode.Length > 0)
        {
            <partial name="_TwoFactorStep" model="Model.Step" />
        }
        else
        {
            <p class="muted">Company admins manage branding, technicians and downloads here. Technicians use the desktop console.</p>
            <form method="post" class="form">
                <label>Email</label><input name="Email" type="email" value="@Model.Email" required autofocus autocomplete="username">
                <label>Password</label><input name="Password" type="password" required autocomplete="current-password">
                <div class="actions"><button class="btn btn-accent btn-lg" type="submit">Sign in</button></div>
            </form>
            <p class="muted" style="margin-top:20px">New here? <a href="/signup">Start a free trial</a>. <a href="/forgot">Forgot your password?</a></p>
        }
    </div>
</section>
