                    '/owner/approvals': svg('<path d="M20 6L9 17l-5-5"/>'),
                    '/owner/pilots': svg('<path d="M4 21V4M4 4h12l-2 4 2 4H4"/>'),
                    '/owner/free': svg('<path d="M12 3l2.2 6.2H21l-5.2 4 2 6.3L12 16.8 6.2 19.5l2-6.3L3 9.2h6.8z"/>'),
                    '/owner/tenants': svg('<path d="M4 21V5h9v16M13 9h7v12"/><path d="M7 9h2M7 13h2M7 17h2"/>'),
                    '/owner/reviews': svg('<path d="M12 3l2.2 6.2H21l-5.2 4 2 6.3L12 16.8 6.2 19.5l2-6.3L3 9.2h6.8z"/>'),
                    '/owner/servers': svg('<rect x="3" y="4" width="18" height="6" rx="1"/><rect x="3" y="14" width="18" height="6" rx="1"/><path d="M7 7h.01M7 17h.01"/>'),
                    '/owner/updates': svg('<path d="M21 12a9 9 0 0 1-15 6.7L3 16M3 12A9 9 0 0 1 18 5.3L21 8"/><path d="M21 3v5h-5M3 21v-5h5"/>'),
                    '/owner/admins': svg('<path d="M12 3l7 3v6c0 5-3 7.5-7 9-4-1.5-7-4-7-9V6z"/>'),
                    '/owner/log': svg('<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>'),
                    '/owner/mail': svg('<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>'),
                    '/owner/payfast': svg('<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>'),
                    '/owner/preview': svg('<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>')
                };
                nav.querySelectorAll('a:not(.pill)').forEach(function (a) {
                    if (!a.querySelector('svg')) {
                        var href = a.getAttribute('href') || '';
                        var mark = icons[href] || icons[href.split('?')[0]];
                        if (!mark && (a.textContent || '').trim() === 'Sign out') mark = svg('<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>');
                        if (mark) a.insertAdjacentHTML('afterbegin', mark);
                    }
                    if (!a.querySelector('.nav-label')) {
                        var loose = [];
                        for (var i = 0; i < a.childNodes.length; i++) {
                            var n = a.childNodes[i];
                            if (n.nodeType === 3 && n.textContent.trim()) loose.push(n);
                        }
                        if (loose.length) {
                            var span = document.createElement('span');
                            span.className = 'nav-label';
                            a.insertBefore(span, loose[0]);
                            loose.forEach(function (n) { span.appendChild(n); });
                            var name = span.textContent.trim();
                            if (name && !a.getAttribute('title')) a.setAttribute('title', name);
                        }
                    }
                });
            }
            if (!nav || !nav.classList.contains('tabs')) return;
            var sections = { t: '/portal/tickets', c: '/portal/clients', a: '/portal/kb', r: '/portal/recurring' };
            var path = location.pathname.replace(/\/$/, '').replace(/^\/portal\/([tcar])(?=\/)/, function (m, k) { return sections[k]; });
            var here = path + location.search, best = null, len = -1;
            document.querySelectorAll('#topnav a:not(.pill), .app-tools a:not(.pill)').forEach(function (a) {
                var h = a.getAttribute('href') || '';
                if (h === '' || h === '#') return;
                var root = h.split('?')[0].split('/').filter(Boolean).length <= 1;
                var ok = here === h || (!root && here.indexOf(h) === 0 && (h.indexOf('?') >= 0 || /[\/?]/.test(here.charAt(h.length))));
                if (ok && h.length > len) { best = a; len = h.length; }
            });
            if (best) best.setAttribute('aria-current', 'page');
        })();
        </script>
    </div>
</header>
<main>
    @if (reviewAsk > 0 && Context.Request.Path != "/portal/review")
    {
        <div class="wrap" style="padding-top:18px">
            <div class="alert alert-ok" id="reviewAsk" data-ask="@reviewAsk">
                <strong>How are we doing?</strong> A short review — some stars and a few words — helps other businesses find us.
                <span style="display:inline-flex;gap:8px;flex-wrap:wrap;margin-left:6px">
                    <a class="btn btn-sm btn-accent" href="/portal/review">Write a review</a>
                    <form method="post" action="/portal/review?handler=Later" class="inline">@Html.AntiForgeryToken()<button class="btn btn-sm" type="submit">Later</button></form>
                    @if (reviewAsk == 2)
                    {
                        <form method="post" action="/portal/review?handler=Never" class="inline">@Html.AntiForgeryToken()<button class="btn btn-sm" type="submit">Don't ask again</button></form>
                    }
                </span>
            </div>
        </div>
    }
    @if (trialTenant != null)
    {
        var daysLeft = trialTenant.TrialDaysLeft ?? 0;
        var lapsed = daysLeft <= 0;
        <div class="wrap" style="padding-top:18px">
            <div class="alert @(lapsed || daysLeft <= 1 ? "alert-bad" : "alert-warn")">
                @if (lapsed)
                {
                    <strong>Your trial ended on @trialTenant.TrialEndsUtc!.Value.Local().ToString("d MMMM yyyy").</strong>
                    <span>
                        Your support software has stopped working — every computer you installed it on is
                        being refused when it tries to connect, and no session can be started. Nothing has
                        been deleted, and it all starts working again the moment the account is activated.
                    </span>
                }
                else
                {
                    <strong>
                        Your trial ends @(daysLeft == 1 ? "tomorrow" : $"in {daysLeft} days"),
                        on @trialTenant.TrialEndsUtc!.Value.Local().ToString("d MMMM yyyy").
                    </strong>
                    <span>
                        When it does, every computer you have installed the software on will stop
                        connecting, all at once, and your technicians will not be able to start a session.
                        Nothing is deleted, and everything resumes as soon as the account is activated.
                    </span>
                }
                <span>Get in touch to carry on.</span>
            </div>
        </div>
    }
    @RenderBody()
</main>
@* The client picker (2026-10-02): every "which client" box in the portal. *@
@if (section == "portal")
{
    <script src="/clientpick.js?v=@RemoteSupport.Platform.Services.BuildStamp.Value" defer></script>
    @* The portal on a phone (2026-10-02): labels every table's cells with their column, so a table
       can be read as cards on a narrow screen instead of swiped sideways. *@
    <script src="/phone.js?v=@RemoteSupport.Platform.Services.BuildStamp.Value" defer></script>
    @* Every comment box grows with what is typed, up to 15 lines (2026-10-13). *@
    <script src="/autogrow.js?v=@RemoteSupport.Platform.Services.BuildStamp.Value" defer></script>
    @* Typing @ in a ticket's comment box lists the people on it first, then everybody else (2026-10-21). *@
    <script src="/mentionpick.js?v=@RemoteSupport.Platform.Services.BuildStamp.Value" defer></script>
}
@* Office chat (3.8.1): on every portal page, for everybody at the office. *@
@if (section == "portal" && (isTenant || isBilling || isTechnician) && !freeTenant)
{
    <script src="/sounds.js?v=@RemoteSupport.Platform.Services.BuildStamp.Value" defer></script>
    <script src="/chat.js?v=@RemoteSupport.Platform.Services.BuildStamp.Value" defer></script>
}
@if (section == "public")
{
    @* Every page of the site from every page (more for a search engine to follow), and the three PayFast checks for:
       terms, refunds and privacy, linked from the home page. *@
    <footer class="foot foot-site">
        <div class="wrap foot-cols">
            <div>
                <h2>The product</h2>
                <a href="/remote-support">Remote support and remote access</a>
                <a href="/ticketing">Job cards and the workshop</a>
                <a href="/health-checks">Monthly health checks</a>
                <a href="/knowledge-base">Knowledge base</a>
                <a href="/website-chat">Live chat</a>
                <a href="/security">Security and POPIA</a>
                <a href="/features">All features</a>
            </div>
            <div>
                <h2>Buying</h2>
                <a href="/pricing">Pricing</a>
                <a href="/remote-workers">For remote workers</a>
                <a href="/terms/ZA">Terms and refunds</a>
                <a href="/privacy">Privacy policy</a>
            </div>
            <div>
                <h2>The company</h2>
                <a href="/about">About us</a>
                <a href="/about#contact">Contact us</a>
                <a href="/support">Help and questions</a>
                <a href="/login">Sign in</a>
            </div>
        </div>
        <div class="wrap foot-legal">
            &copy; @DateTime.UtcNow.Year The Remote Support Program (Pty) Ltd &middot; Reg. 2026/737434/07 &middot;
            19 Tide Street, Knysna, Western Cape, South Africa &middot; queries@@theremotesupportprogram.com &middot; 078 131 5618
        </div>
    </footer>
    @* A screenshot full size, over the page (2026-10-14): any _Shot picture, the one showing in the page's light or dark.
       Without a script, or a browser with no <dialog>, the link opens the picture itself. *@
    <dialog id="shotView" class="shot-view" aria-label="Screenshot, full size">
        <button type="button" class="shot-close" aria-label="Close">✕</button>
        <img alt="">
    </dialog>
    <script>
    (function () {
        var d = document.getElementById('shotView'), im = d.querySelector('img');
        if (!d.showModal) return;
        document.addEventListener('click', function (e) {
            var a = e.target.closest && e.target.closest('a[data-shot]');
            if (!a) return;
            var shown = Array.prototype.filter.call(a.querySelectorAll('img'), function (i) { return i.getClientRects().length > 0; })[0];
            if (!shown) return;
            e.preventDefault();
            im.src = shown.currentSrc || shown.src; im.alt = shown.alt;
            d.showModal();
        });
        d.addEventListener('click', function () { d.close(); });
    })();
    </script>
    @* Our own website chat (§70) answers visitors — people, not AI (Clint, 2026-10-13: an AI assistant was a POPIA
       problem). Whose chat is Platform:SiteChatSlug; unset, no bubble. ?site=1: it says The Remote Support Program in
       our colour, answered by that company's people (Services/SiteChat.cs). go-live.sh sets the slug with -RealSite. *@
    @if (RemoteSupport.Platform.Services.SiteChat.Slug(Cfg) is { } chatSlug)
    {
        <script src="/webchat/@(Uri.EscapeDataString(chatSlug)).js?site=1" async></script>
    }
}
else
{
    <footer class="foot">
        <div class="wrap">
            <div>&copy; @DateTime.UtcNow.Year The Remote Support Program &middot; theremotesupportprogram.com</div>
            <div><a href="/features">Features</a> &middot; <a href="/pricing">Pricing</a> &middot; <a href="/support">Support</a> &middot; <a href="/login">Sign in</a></div>
        </div>
    </footer>
}
</body>
</html>
