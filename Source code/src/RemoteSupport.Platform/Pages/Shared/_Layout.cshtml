                    '/portal/jobtypes': svg('<path d="M4 6h16M4 12h16M4 18h16"/><circle cx="8" cy="6" r="1.5"/><circle cx="14" cy="12" r="1.5"/><circle cx="10" cy="18" r="1.5"/>'),
                    '/portal/branding': svg('<circle cx="12" cy="12" r="9"/><circle cx="12" cy="8" r="1.5"/><circle cx="8" cy="13" r="1.5"/><circle cx="16" cy="13" r="1.5"/>'),
                    '/portal/technicians': svg('<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>'),
                    '/portal/downloads': svg('<path d="M12 3v12M7 11l5 5 5-5M5 21h14"/>'),
                    '/portal/websupport': svg('<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18"/>'),
                    '/portal/outsiders': svg('<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>'),
                    '/portal/webchat': svg('<path d="M21 12a8 8 0 0 1-8 8H7l-4 3V12a8 8 0 1 1 18 0z"/>'),
                    '/portal/mailintake': svg('<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>'),
                    '/portal/export': svg('<path d="M14 3h7v7M21 3l-9 9M5 5h6M5 5v14h14v-6"/>'),
                    '/portal/account': svg('<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>'),
