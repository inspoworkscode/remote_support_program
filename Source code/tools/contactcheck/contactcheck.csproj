<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>contactcheck</AssemblyName>
    <RootNamespace>RemoteSupport.Tools.ContactCheck</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Against the REAL model, the REAL migrations and the REAL ContactService, on a throwaway
         SQLite file. A harness with its own copy of the rules would pass while the product was
         broken, which is the one thing a harness must not do. -->
    <ProjectReference Include="..\..\src\RemoteSupport.Platform\RemoteSupport.Platform.csproj" />
    <Compile Include="..\Common\OldRows.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Which database its throwaway platform runs on: SQLite, or PostgreSQL with RSP_TEST_DB=postgres (HANDOVER 118). -->
    <Compile Include="..\Common\HarnessDb.cs" />
    <Compile Include="..\Common\TestPostgres.cs" />
    <Compile Include="..\Common\HarnessDb.Ef.cs" />
  </ItemGroup>
</Project>
