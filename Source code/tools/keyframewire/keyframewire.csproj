<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>keyframewire</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- The platform, built to a folder of its own and run; it brings Shared. -->
    <ProjectReference Include="..\..\src\RemoteSupport.Platform\RemoteSupport.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Which database its throwaway platform runs on: SQLite, or PostgreSQL with RSP_TEST_DB=postgres (HANDOVER 118). -->
    <Compile Include="..\Common\HarnessDb.cs" />
    <Compile Include="..\Common\TestPostgres.cs" />
    <Compile Include="..\Common\HarnessDb.Ef.cs" />
  </ItemGroup>
</Project>
