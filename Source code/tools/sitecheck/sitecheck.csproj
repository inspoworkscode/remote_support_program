<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>sitecheck</AssemblyName>
    <RootNamespace>RemoteSupport.Tools.SiteCheck</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\RemoteSupport.Shared\RemoteSupport.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Which database its throwaway platform runs on: SQLite, or PostgreSQL with RSP_TEST_DB=postgres (HANDOVER 118). -->
    <Compile Include="..\Common\HarnessDb.cs" />
    <Compile Include="..\Common\TestPostgres.cs" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <!-- An HTML5 parser that reports every parse error, as the W3C checker would (no Java or Node here). Harness only. -->
    <PackageReference Include="AngleSharp" Version="1.1.2" />
  </ItemGroup>
</Project>
