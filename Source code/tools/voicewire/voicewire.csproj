<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>voicewire</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- The platform for reading the throwaway database's ticket notes back (it brings Shared), and
         the HOST for its real VoiceCall: the pretend machine answers with the host's own code. -->
    <ProjectReference Include="..\..\src\RemoteSupport.Platform\RemoteSupport.Platform.csproj" />
    <ProjectReference Include="..\..\src\RemoteSupport.Host\RemoteSupport.Host.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Which database its throwaway platform runs on: SQLite, or PostgreSQL with RSP_TEST_DB=postgres (HANDOVER 118). -->
    <Compile Include="..\Common\HarnessDb.cs" />
    <Compile Include="..\Common\TestPostgres.cs" />
    <Compile Include="..\Common\HarnessDb.Ef.cs" />
  </ItemGroup>
</Project>
