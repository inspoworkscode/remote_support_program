<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>backfill-clients</AssemblyName>
    <RootNamespace>RemoteSupport.Tools.BackfillClients</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Talks to the database directly rather than through EF, so the tool keeps working
         even as the model moves on, and cannot accidentally run a migration. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <None Update="backfill-clients.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
