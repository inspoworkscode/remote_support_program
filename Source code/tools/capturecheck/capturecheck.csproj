<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- System.Drawing, so the harness can decode tiles exactly like ScreenView does -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <!-- Portal credentials helper, shared by the harnesses; keeps the password out of the repo. -->
    <Compile Include="..\Common\RsCredentials.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\RemoteSupport.Shared\RemoteSupport.Shared.csproj" />
  </ItemGroup>
</Project>
