<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>clockcheck</AssemblyName>
    <RootNamespace>RemoteSupport.Tools.ClockCheck</RootNamespace>
    <!-- As the platform is built: with it, Windows cannot find "Africa/Johannesburg" by itself. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\RemoteSupport.Platform\RemoteSupport.Platform.csproj" />
    <Compile Include="..\Common\OldRows.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Which database its throwaway platform runs on: SQLite, or PostgreSQL with RSP_TEST_DB=postgres (HANDOVER 118). -->
    <Compile Include="..\Common\HarnessDb.cs" />
    <Compile Include="..\Common\TestPostgres.cs" />
    <Compile Include="..\Common\HarnessDb.Ef.cs" />
  </ItemGroup>
</Project>
