<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>sharpwire</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- The platform, built to a folder of its own and run; it brings Shared. Media decodes as the console does. -->
    <ProjectReference Include="..\..\src\RemoteSupport.Platform\RemoteSupport.Platform.csproj" />
    <ProjectReference Include="..\..\src\RemoteSupport.Media\RemoteSupport.Media.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Which database its throwaway platform runs on: SQLite, or PostgreSQL with RSP_TEST_DB=postgres (HANDOVER 118). -->
    <Compile Include="..\Common\HarnessDb.cs" />
    <Compile Include="..\Common\TestPostgres.cs" />
    <Compile Include="..\Common\HarnessDb.Ef.cs" />
    <!-- codecbench's still page, with its blinking cursor and the window that opens. -->
    <Compile Include="..\codecbench\Scene.cs" />
    <Compile Include="..\codecbench\SceneHost.cs" />
  </ItemGroup>
</Project>
